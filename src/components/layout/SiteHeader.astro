---
import { isActiveNavigationPath, site } from '@/config/site';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/" aria-label={`${site.title} home`}>{site.title}</a>
    <nav aria-label="Primary navigation">
      <ul class="site-header__nav">
        {site.navigation.map((item) => (
          <li>
            <a href={item.href} aria-current={isActiveNavigationPath(currentPath, item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <p class="site-header__opportunity">{site.opportunityLabel}</p>
  </div>
</header>

<style>
  .site-header { border-bottom: var(--border-width) solid var(--border-subtle); background: color-mix(in srgb, var(--surface-canvas) 94%, var(--surface-raised)); }
  .site-header__inner { display: grid; gap: var(--space-2); padding-block: var(--space-3); }
  .site-header__brand { display: inline-flex; align-items: center; width: fit-content; color: var(--text-primary); font-size: var(--text-lg); font-weight: 750; letter-spacing: -0.025em; text-decoration: none; }
  .site-header nav { min-width: 0; }
  .site-header__nav { display: flex; flex-wrap: wrap; gap: var(--space-1); margin: 0; list-style: none; }
  .site-header__nav a { display: inline-flex; align-items: center; justify-content: center; min-width: 2.75rem; min-height: 2.75rem; padding-inline: var(--space-2); border: var(--border-width) solid transparent; border-radius: var(--radius-sm); color: var(--text-secondary); font-size: var(--text-sm); font-weight: 650; text-decoration: none; }
  .site-header__nav a:hover { border-color: var(--border-subtle); background: var(--surface-raised); color: var(--text-primary); }
  .site-header__nav a[aria-current='page'] { border-color: var(--border-strong); background: var(--surface-overlay); color: var(--text-primary); box-shadow: inset 0 -2px 0 var(--accent-system); }
  .site-header__opportunity { align-self: center; width: fit-content; margin: 0; color: var(--text-muted); font-size: var(--text-xs); }
  @media (min-width: 64rem) {
    .site-header__inner { grid-template-columns: minmax(11rem, auto) 1fr auto; align-items: center; gap: var(--space-5); padding-block: var(--space-4); }
    .site-header__nav { justify-content: center; gap: var(--space-1); }
    .site-header__opportunity { padding: var(--space-1) var(--space-2); border-left: 2px solid var(--state-verified); }
  }
</style>
