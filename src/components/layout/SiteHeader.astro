---
import { isActiveNavigationPath, site } from '@/config/site';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/" aria-label={`${site.title} home`}>{site.title}</a>
    <nav aria-label="Primary navigation">
      <ul class="site-header__nav">
        {site.navigation.map((item) => (
          <li>
            <a href={item.href} aria-current={isActiveNavigationPath(currentPath, item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <p class="site-header__opportunity">{site.opportunityLabel}</p>
  </div>
</header>

<style>
  .site-header { border-bottom: var(--border-width) solid var(--border-subtle); }
  .site-header__inner { display: grid; gap: var(--space-3); padding-block: var(--space-4); }
  .site-header__brand { align-self: center; color: var(--text-primary); font-weight: 700; text-decoration: none; }
  .site-header__nav { display: flex; flex-wrap: wrap; gap: 0 var(--space-3); margin: 0; list-style: none; }
  .site-header__nav a { display: inline-flex; align-items: center; color: var(--text-secondary); font-size: var(--text-sm); text-decoration: none; }
  .site-header__nav a[aria-current='page'] { color: var(--accent-system); }
  .site-header__opportunity { align-self: center; margin: 0; color: var(--text-muted); font-size: var(--text-xs); }
  @media (min-width: 64rem) { .site-header__inner { grid-template-columns: auto 1fr auto; align-items: center; } .site-header__nav { justify-content: center; } }
</style>
