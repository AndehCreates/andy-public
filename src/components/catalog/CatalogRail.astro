---
interface TocItem { slug: string; text: string; }
interface Props { position: string; items: TocItem[]; observatoryHref?: string | undefined; }
const { position, items, observatoryHref } = Astro.props;
---

<aside class="catalog-rail" aria-label="System position">
  <p class="catalog-rail__label">System position</p>
  <p>{position}</p>
  {observatoryHref && <a href={observatoryHref}>Return to Observatory</a>}
  <nav aria-label="Dossier chapters">
    <ol>{items.map((item) => <li><a href={`#${item.slug}`} aria-current={item.slug === 'why-it-matters' ? 'location' : undefined}>{item.text}</a></li>)}</ol>
  </nav>
</aside>

<details class="catalog-chapters" data-dossier-chapters>
  <summary>On this page</summary>
  <nav aria-label="Dossier chapters"><ol>{items.map((item) => <li><a href={`#${item.slug}`} aria-current={item.slug === 'why-it-matters' ? 'location' : undefined}>{item.text}</a></li>)}</ol></nav>
</details>

<style>
  .catalog-rail { position: sticky; top: var(--space-5); align-self: start; padding: var(--space-4); border-left: 2px solid var(--accent-system); color: var(--text-secondary); font-size: var(--text-sm); }
  .catalog-rail__label { margin: 0; color: var(--text-primary); font-weight: 700; }
  .catalog-rail > p:not(.catalog-rail__label) { margin: var(--space-2) 0 var(--space-4); }
  .catalog-rail a { display: inline-flex; min-height: 44px; align-items: center; color: var(--accent-system); }
  .catalog-rail ol, .catalog-chapters ol { display: grid; gap: var(--space-1); margin: var(--space-3) 0 0; padding-left: var(--space-4); }
  .catalog-chapters { display: none; margin-block: var(--space-5); padding: var(--space-3); border: var(--border-width) solid var(--border-subtle); border-radius: var(--radius-md); }
  .catalog-chapters summary { min-height: 44px; display: flex; align-items: center; color: var(--text-primary); font-weight: 700; cursor: pointer; }
  @media (max-width: 767px) { .catalog-rail { display: none; } .catalog-chapters { display: block; } }
</style>
