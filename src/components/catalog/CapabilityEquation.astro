---
interface Props {
  friction: string;
  response: string;
  capability: string;
}

const { friction, response, capability } = Astro.props;
---

<section class="capability-equation" aria-labelledby="capability-equation-title">
  <h2 id="capability-equation-title">Capability equation</h2>
  <dl>
    <div><dt>Friction</dt><dd>{friction}</dd></div>
    <div><dt>Response</dt><dd>{response}</dd></div>
    <div><dt>Capability</dt><dd>{capability}</dd></div>
  </dl>
</section>

<style>
  .capability-equation { padding: var(--space-5); border: var(--border-width) solid var(--border-strong); border-radius: var(--radius-lg); background: var(--surface-raised); }
  h2 { margin: 0; color: var(--text-primary); font-size: var(--text-lg); }
  dl { display: grid; gap: var(--space-4); margin: var(--space-4) 0 0; }
  dt { color: var(--accent-system); font-size: var(--text-xs); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  dd { margin: var(--space-1) 0 0; color: var(--text-secondary); }
</style>
