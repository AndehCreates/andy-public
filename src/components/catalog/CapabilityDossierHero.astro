---
interface Props { title: string; thesis: string; summary: string; status?: string | undefined; }
const { title, thesis, summary, status } = Astro.props;
---

<header class="dossier-hero">
  <p class="dossier-hero__eyebrow">Capability thesis</p>
  <h1>{title}</h1>
  <p class="dossier-hero__thesis">{thesis}</p>
  <p class="dossier-hero__summary">{summary}</p>
  {status && <p class="dossier-hero__status">{status}</p>}
</header>

<style>
  .dossier-hero { padding-block: var(--space-7) var(--space-6); border-bottom: var(--border-width) solid var(--border-subtle); }
  .dossier-hero__eyebrow, .dossier-hero__status { margin: 0; color: var(--accent-system); font-size: var(--text-xs); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  h1 { margin: var(--space-3) 0 0; color: var(--text-primary); font-size: var(--text-3xl); line-height: 1.05; }
  .dossier-hero__thesis { max-width: 42rem; margin: var(--space-4) 0 0; color: var(--text-primary); font-size: var(--text-xl); line-height: 1.35; }
  .dossier-hero__summary { max-width: 42rem; margin: var(--space-4) 0 0; color: var(--text-secondary); }
  .dossier-hero__status { margin-top: var(--space-5); color: var(--state-verified); }
</style>
