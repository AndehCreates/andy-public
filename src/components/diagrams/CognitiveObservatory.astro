---
import type { SystemProjection } from '@/lib/content/catalog';

interface Props {
  projection: SystemProjection;
}

const { projection } = Astro.props;
const projectHrefs: Record<string, string> = {
  'projects:project-chief-of-staff': '/work/chief-of-staff/',
};

const projectHref = (projectTarget: string | undefined) => projectTarget ? projectHrefs[projectTarget] : undefined;
---

<section class="cognitive-observatory" data-cognitive-observatory aria-labelledby="cognitive-observatory-title">
  <header class="cognitive-observatory__header">
    <p>Systems Observatory</p>
    <h2 id="cognitive-observatory-title">A layered system for accountable work</h2>
    <p>{projection.thesis}</p>
  </header>

  <div class="cognitive-observatory__semantic">
    <ol class="cognitive-observatory__layers">
      {projection.layers.map((layer, index) => (
        <li class:list={['cognitive-observatory__layer', `cognitive-observatory__layer--${layer.theme}`]}>
          <div class="cognitive-observatory__layer-heading">
            <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{layer.label}</h3>
              <p>{layer.responsibility}</p>
            </div>
          </div>
          <p class="cognitive-observatory__boundary"><strong>Authority boundary:</strong> {layer.authorityBoundary}</p>
          <ul class="cognitive-observatory__components">
            {layer.components.map((component) => {
              const href = projectHref(component.projectTarget);
              return (
                <li>
                  <strong>{href ? <a href={href}>{component.label}</a> : component.label}:</strong> {component.responsibility}
                  <span> {component.authorityBoundary}</span>
                </li>
              );
            })}
          </ul>
        </li>
      ))}
    </ol>
  </div>

  <div class="cognitive-observatory__visual" aria-hidden="true">
    <div class="cognitive-observatory__visual-core">Human direction</div>
    <div class="cognitive-observatory__visual-rings">
      {projection.layers.slice(1).map((layer) => (
        <div class:list={['cognitive-observatory__visual-ring', `cognitive-observatory__visual-ring--${layer.theme}`]}>
          <span>{layer.label}</span>
          <small>{layer.components.map((component) => component.label).join(' / ')}</small>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .cognitive-observatory { margin-block: var(--space-7); padding: var(--space-5); border: var(--border-width) solid color-mix(in srgb, var(--accent-system) 40%, var(--border-subtle)); background: var(--surface-sunken); }
  .cognitive-observatory__header { display: grid; gap: var(--space-3); max-width: 46rem; }
  .cognitive-observatory__header :is(h2, p) { margin: 0; }
  .cognitive-observatory__header > p:first-child { color: var(--accent-system); font-size: var(--text-xs); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .cognitive-observatory__header h2 { color: var(--text-primary); font-size: var(--text-2xl); line-height: 1.05; }
  .cognitive-observatory__header > p:last-child { color: var(--text-secondary); font-size: var(--text-lg); }
  .cognitive-observatory__layers { display: grid; gap: var(--space-3); margin: var(--space-6) 0 0; list-style: none; }
  .cognitive-observatory__layer { display: grid; gap: var(--space-3); padding: var(--space-4); border-left: 2px solid var(--state-boundary); background: var(--surface-raised); }
  .cognitive-observatory__layer--authority { border-color: var(--state-human-control); }
  .cognitive-observatory__layer--continuity, .cognitive-observatory__layer--context { border-color: var(--accent-continuity); }
  .cognitive-observatory__layer--execution { border-color: var(--accent-system); }
  .cognitive-observatory__layer--feedback, .cognitive-observatory__layer--evidence { border-color: var(--accent-evidence); }
  .cognitive-observatory__layer-heading { display: grid; grid-template-columns: 2.25rem minmax(0, 1fr); gap: var(--space-3); }
  .cognitive-observatory__layer-heading > span { color: var(--text-muted); font-family: var(--font-mono); font-size: var(--text-sm); }
  .cognitive-observatory__layer-heading :is(h3, p), .cognitive-observatory__boundary { margin: 0; }
  .cognitive-observatory__layer h3 { color: var(--text-primary); font-size: var(--text-xl); line-height: 1.1; }
  .cognitive-observatory__layer-heading p, .cognitive-observatory__boundary { color: var(--text-secondary); }
  .cognitive-observatory__boundary { font-size: var(--text-sm); }
  .cognitive-observatory__components { display: grid; gap: var(--space-2); margin: 0; padding-left: var(--space-5); color: var(--text-secondary); }
  .cognitive-observatory__components strong { color: var(--text-primary); }
  .cognitive-observatory__components a { color: var(--accent-system); }
  .cognitive-observatory__visual { display: none; }
  @media (min-width: 64rem) {
    .cognitive-observatory { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(20rem, .85fr); column-gap: var(--space-6); align-items: start; }
    .cognitive-observatory__header { grid-column: 1 / -1; }
    .cognitive-observatory__visual { position: sticky; top: var(--space-5); display: grid; place-items: center; min-height: 34rem; padding: var(--space-5); overflow: hidden; border: var(--border-width) solid var(--border-subtle); background: var(--surface-raised); }
    .cognitive-observatory__visual::before { position: absolute; inset: 12%; border: var(--border-width) solid var(--border-strong); border-radius: 50%; content: ''; }
    .cognitive-observatory__visual-core { position: relative; z-index: 1; width: 9rem; aspect-ratio: 1; display: grid; place-items: center; padding: var(--space-3); border: 2px solid var(--state-human-control); border-radius: 50%; color: var(--text-primary); font-weight: 700; text-align: center; }
    .cognitive-observatory__visual-rings { position: absolute; inset: var(--space-5); display: grid; align-content: center; gap: var(--space-3); }
    .cognitive-observatory__visual-ring { display: grid; gap: var(--space-1); padding: var(--space-3); border-left: 2px solid var(--state-boundary); background: color-mix(in srgb, var(--surface-sunken) 88%, transparent); }
    .cognitive-observatory__visual-ring--continuity, .cognitive-observatory__visual-ring--context { border-color: var(--accent-continuity); }
    .cognitive-observatory__visual-ring--execution { border-color: var(--accent-system); }
    .cognitive-observatory__visual-ring--feedback, .cognitive-observatory__visual-ring--evidence { border-color: var(--accent-evidence); }
    .cognitive-observatory__visual-ring span { color: var(--text-primary); font-weight: 700; }
    .cognitive-observatory__visual-ring small { color: var(--text-secondary); font-size: var(--text-xs); }
  }
</style>
