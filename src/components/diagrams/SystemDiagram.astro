---
import type { DiagramConfiguration, DiagramVariant, FlagshipTheme } from '@/lib/content/presentation';

interface DiagramNode {
  id?: string;
  label: string;
  description: string;
}

interface DiagramEdge {
  from: string;
  to: string;
  label?: string;
}

interface Props {
  title?: string;
  description?: string;
  nodes?: readonly DiagramNode[];
  edges?: readonly DiagramEdge[];
  diagram?: DiagramConfiguration;
  variant?: DiagramVariant;
  theme?: FlagshipTheme;
  compact?: boolean;
  headingLevel?: 2 | 3;
}

const slugify = (value: string) => value.toLowerCase().replaceAll(/[^a-z0-9]+/g, '-').replaceAll(/(^-|-$)/g, '');

const {
  diagram,
  compact = false,
  headingLevel = 3,
} = Astro.props;

const title = Astro.props.title ?? diagram?.title;
const description = Astro.props.description ?? diagram?.description;
const suppliedNodes = Astro.props.nodes ?? diagram?.nodes;
const edges = Astro.props.edges ?? diagram?.edges;
const variant = Astro.props.variant ?? diagram?.variant;

if (!title || !description || !suppliedNodes || !edges) {
  throw new Error('SystemDiagram requires a title, description, nodes, and edges.');
}

const themesByVariant: Record<DiagramVariant, FlagshipTheme> = {
  'authority-boundaries': 'authority',
  'continuity-reentry': 'continuity',
  'evidence-gates': 'evidence',
};
const inferredTheme = variant ? themesByVariant[variant] : 'authority';
const theme = Astro.props.theme ?? inferredTheme;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const Subheading = headingLevel === 2 ? 'h3' : 'h4';
const diagramId = `${slugify(title)}-diagram`;
const nodes = suppliedNodes.map((node) => ({ ...node, id: node.id ?? slugify(node.label) }));
const nodesByReference = new Map(nodes.flatMap((node) => [[node.id, node], [node.label, node]]));
const resolveNode = (reference: string) => nodesByReference.get(reference) ?? {
  id: slugify(reference),
  label: reference,
  description: '',
};
const humanDecisionIds = new Set([
  'governance',
  'human-judgment',
  'human-review',
  'user-confirmed-interventions',
]);
const boundaryIds = new Set([
  'governance',
  'runtime-workers',
  'runtime-and-workers',
  'project-repositories',
  'local-persistence',
  'synchronization',
  'validation-trust-gates',
]);
const nodeRole = (id: string) => humanDecisionIds.has(id)
  ? 'human-decision'
  : boundaryIds.has(id)
    ? 'boundary'
    : 'component';
const relationships = edges.map((edge) => ({
  ...edge,
  fromNode: resolveNode(edge.from),
  toNode: resolveNode(edge.to),
})).map((relationship) => ({
  ...relationship,
  fromRole: nodeRole(relationship.fromNode.id),
  toRole: nodeRole(relationship.toNode.id),
}));
---

<section
  class:list={['system-diagram', compact && 'system-diagram--compact']}
  aria-labelledby={`${diagramId}-title`}
  aria-describedby={`${diagramId}-description`}
  data-diagram-theme={theme}
  data-diagram-variant={variant}
>
  <header class="system-diagram__header">
    <p class="system-diagram__eyebrow">System diagram</p>
    <Heading id={`${diagramId}-title`}>{title}</Heading>
    <p id={`${diagramId}-description`}>{description}</p>
  </header>

  <div class="system-diagram__visual" aria-hidden="true">
    <div class="system-diagram__flow">
      {relationships.map(({ fromNode, toNode, fromRole, toRole, label }) => (
        <div class="system-diagram__flow-row">
          <div class="system-diagram__node" data-node-id={fromNode.id} data-node-role={fromRole}>
            <span>{fromNode.label}</span>
            {fromRole === 'human-decision' && <small>Human decision</small>}
          </div>
          <div class="system-diagram__connector">
            <span>{label ?? 'flows to'}</span>
            <i></i>
          </div>
          <div class="system-diagram__node" data-node-id={toNode.id} data-node-role={toRole}>
            <span>{toNode.label}</span>
            {toRole === 'human-decision' && <small>Human decision</small>}
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="system-diagram__text">
    <Subheading class="system-diagram__components-heading">Components</Subheading>
    <ul class="system-diagram__components">
      {nodes.map((node) => (
        <li data-node-id={node.id}>
          <strong>{node.label}:</strong> {node.description}
        </li>
      ))}
    </ul>
    <Subheading>Relationships</Subheading>
    <ol class="system-diagram__relationships">
      {relationships.map(({ fromNode, toNode, label }) => (
        <li class="system-diagram__relationship">
          <span>From <strong>{fromNode.label}</strong>.</span>
          <span>{label ? `${label}.` : 'Flows to.'}</span>
          <span>To <strong>{toNode.label}</strong>.</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .system-diagram {
    --diagram-accent: var(--accent-authority);
    margin-block: var(--space-7);
    padding: var(--space-5);
    overflow: visible;
    border: var(--border-width) solid color-mix(in srgb, var(--diagram-accent) 32%, var(--border-subtle));
    border-radius: var(--radius-md);
    background: var(--surface-sunken);
  }
  .system-diagram[data-diagram-theme='continuity'] { --diagram-accent: var(--accent-continuity); }
  .system-diagram[data-diagram-theme='evidence'] { --diagram-accent: var(--accent-evidence); }
  .system-diagram__eyebrow { margin: 0 0 var(--space-2); color: var(--diagram-accent); font-size: var(--text-xs); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .system-diagram :is(h2, h3, h4, p) { margin: 0; }
  .system-diagram__header > p:last-child { margin-top: var(--space-2); max-width: 58rem; color: var(--text-secondary); }
  .system-diagram__visual { margin-top: var(--space-5); padding: var(--space-4); border-radius: var(--radius-sm); background: var(--surface-raised); }
  .system-diagram__flow { display: grid; gap: var(--space-3); }
  .system-diagram__flow-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(8rem, .7fr) minmax(0, 1fr); align-items: center; gap: var(--space-3); }
  .system-diagram__node { min-width: 0; padding: var(--space-3); border: var(--border-width) solid var(--diagram-accent); border-radius: var(--radius-sm); color: var(--text-primary); font-size: var(--text-sm); font-weight: 700; text-align: center; }
  .system-diagram__node[data-node-role='boundary'] { border-color: var(--state-boundary); border-style: dashed; }
  .system-diagram__node[data-node-role='human-decision'] { border-color: var(--state-human-control); }
  .system-diagram__node small { display: block; margin-top: var(--space-1); color: var(--state-human-control); font-family: var(--font-mono); font-size: .625rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; }
  .system-diagram__connector { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: var(--space-2); color: var(--text-secondary); font-family: var(--font-mono); font-size: var(--text-xs); line-height: 1.35; text-align: center; }
  .system-diagram__connector::after { content: '›'; grid-column: 2; grid-row: 2; margin-right: -.15rem; color: var(--diagram-accent); font-family: var(--font-sans); font-size: 1.4rem; line-height: .35; }
  .system-diagram__connector i { grid-column: 1 / -1; grid-row: 2; height: 1px; background: linear-gradient(90deg, var(--border-strong), var(--diagram-accent)); }
  .system-diagram__text { margin-top: var(--space-5); }
  .system-diagram__text :is(h3, h4) + :is(ul, ol) { margin-top: var(--space-2); }
  .system-diagram__text :is(h3, h4):not(:first-child) { margin-top: var(--space-4); }
  .system-diagram__components { padding-left: var(--space-5); }
  .system-diagram__relationships { display: grid; gap: var(--space-2); padding-left: var(--space-5); }
  .system-diagram__relationship > span:not(:last-child) { margin-right: .3em; }
  .system-diagram--compact :is(.system-diagram__components-heading, .system-diagram__components) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 48rem) {
    .system-diagram { padding: var(--space-4); }
    .system-diagram__visual { display: none; }
    .system-diagram__relationships { padding: 0; list-style: none; }
    .system-diagram__relationship { display: grid; gap: var(--space-1); padding: var(--space-3); border-left: 2px solid var(--diagram-accent); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; background: var(--surface-raised); }
    .system-diagram__relationship > span { margin: 0; overflow-wrap: anywhere; }
    .system-diagram__relationship > span:nth-child(2) { color: var(--diagram-accent); font-family: var(--font-mono); font-size: var(--text-xs); }
  }
</style>
