---
import type { SignalAtlasSignalView } from '@/lib/content/signalAtlas';

interface Props {
  signal: SignalAtlasSignalView;
}

const { signal } = Astro.props;
---

<aside class="signal-artifact-record" data-signal-artifact-record aria-label={`Artifact record for ${signal.title}`}>
  <p class="signal-artifact-record__label">Artifact record</p>
  <dl>
    <div><dt>What was inspected</dt><dd>{signal.artifactLabel}</dd></div>
    <div><dt>What it revealed</dt><dd>{signal.finding}</dd></div>
    <div><dt>Evidence</dt><dd>{signal.evidenceSummary}</dd></div>
    <div class="signal-artifact-record__boundary"><dt>Evidence boundary</dt><dd>{signal.evidenceBoundary}</dd></div>
    <div><dt>Why continue</dt><dd>{signal.continueAnnotation}</dd></div>
  </dl>
</aside>

<style>
  .signal-artifact-record { display: grid; align-content: start; gap: var(--space-4); padding: var(--space-5) 0; border-top: var(--border-width) solid var(--accent-evidence); border-bottom: var(--border-width) solid var(--border-subtle); }
  .signal-artifact-record__label { color: var(--accent-evidence); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: .06em; text-transform: uppercase; }
  dl { display: grid; gap: 0; }
  dl > div { padding-block: var(--space-3); border-top: var(--border-width) solid var(--border-subtle); }
  dl > div:first-child { border-top: 0; }
  dt { margin-bottom: var(--space-1); color: var(--text-muted); font-family: var(--font-mono); font-size: .6875rem; letter-spacing: .05em; text-transform: uppercase; }
  dd { color: var(--text-secondary); font-size: var(--text-sm); line-height: 1.55; }
  .signal-artifact-record__boundary dt { color: var(--state-human-control); }
</style>
