---
import type { CollectionEntry } from 'astro:content';
import type { SignalAtlasRecord } from '@/lib/content/signalAtlas';
import type { ContentCollectionName } from '@/lib/content/types';

interface Props {
  signal: CollectionEntry<'signals'>['data'];
  continuation: SignalAtlasRecord;
}

const { signal, continuation } = Astro.props;
const continuationLabels = {
  projects: 'project',
  caseStudies: 'case study',
  systems: 'system map',
  handbook: 'handbook principle',
  signals: 'Signal annotation',
} satisfies Record<ContentCollectionName, string>;
const continuationLabel = continuationLabels[continuation.collection];
---

<section class="signal-context" data-signal-context aria-labelledby="signal-context-heading">
  <h2 id="signal-context-heading">Signal context</h2>
  <dl>
    <div>
      <dt>What was inspected</dt>
      <dd>{signal.artifactLabel}</dd>
      {signal.sourceContext && <p>{signal.sourceContext}</p>}
    </div>
    <div>
      <dt>What it revealed</dt>
      <dd>{signal.finding}</dd>
    </div>
    <div class="signal-context__evidence">
      <dt>Evidence summary</dt>
      <dd>{signal.evidenceSummary}</dd>
    </div>
    <div class="signal-context__boundary">
      <dt>What the evidence does not establish</dt>
      <dd>{signal.evidenceBoundary}</dd>
    </div>
  </dl>
  <p class="signal-context__annotation">{signal.continueTo?.annotation}</p>
  <nav class="signal-context__links" aria-label="Continue reading">
    <a href={continuation.href}>Continue to the {continuation.title} {continuationLabel}</a>
    <a href="/signals/">Return to the Signal Library atlas</a>
  </nav>
</section>

<style>
  .signal-context { display: grid; gap: var(--space-4); padding-block: var(--space-5); border-top: var(--border-width) solid var(--accent-signal); border-bottom: var(--border-width) solid var(--border-subtle); }
  h2 { margin: 0; color: var(--text-primary); font-size: var(--text-base); }
  dl { display: grid; gap: 0; margin: 0; }
  dl > div { padding-block: var(--space-3); border-top: var(--border-width) solid var(--border-subtle); }
  dt { margin-bottom: var(--space-1); color: var(--text-muted); font-family: var(--font-mono); font-size: .6875rem; letter-spacing: .05em; text-transform: uppercase; }
  dd { margin: 0; color: var(--text-secondary); font-size: var(--text-sm); line-height: 1.55; }
  dl p { margin: var(--space-1) 0 0; color: var(--text-muted); font-size: var(--text-xs); }
  .signal-context__evidence dt { color: var(--accent-evidence); }
  .signal-context__boundary dt { color: var(--state-human-control); }
  .signal-context__annotation { margin: 0; color: var(--text-secondary); font-size: var(--text-sm); line-height: 1.55; }
  .signal-context__links { display: grid; gap: var(--space-2); padding-top: var(--space-3); border-top: var(--border-width) solid var(--border-subtle); }
  .signal-context__links a { width: fit-content; color: var(--accent-signal); font-weight: 700; }
  .signal-context__links a:last-child { color: var(--text-muted); font-weight: 500; }
  .signal-context__links a:hover { color: var(--text-primary); }
</style>
