---
interface Props {
  src: string;
  alt?: string;
  decorative?: boolean;
  caption?: string;
  credit?: string;
}

const { src, alt, decorative = false, caption, credit } = Astro.props;

if (!decorative && !alt?.trim()) {
  throw new Error('MediaFigure requires useful alt text unless marked decorative.');
}
---

<figure class="media-figure">
  <img src={src} alt={decorative ? '' : alt} aria-hidden={decorative ? 'true' : undefined} />
  {(caption || credit) && <figcaption>{caption}{caption && credit ? ' ' : ''}{credit && <span class="media-figure__credit">{credit}</span>}</figcaption>}
</figure>

<style>
  .media-figure { margin-inline: 0; }
  .media-figure img { display: block; width: 100%; border: var(--border-width) solid var(--border-subtle); border-radius: var(--radius-md); }
  .media-figure__credit { color: var(--text-muted); }
</style>
