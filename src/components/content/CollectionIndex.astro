---
import ProjectCard, { type ProjectCardViewModel } from './ProjectCard.astro';

interface Props {
  heading: string;
  description: string;
  projects: ProjectCardViewModel[];
}

const { heading, description, projects } = Astro.props;
---

<section class="collection-index container" aria-labelledby="collection-heading">
  <header class="collection-index__header">
    <p class="collection-index__eyebrow">Work</p>
    <h1 id="collection-heading">{heading}</h1>
    <p>{description}</p>
    <p class="collection-index__count">{projects.length} {projects.length === 1 ? 'project' : 'projects'} in this collection</p>
  </header>
  <div class="collection-index__grid">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>

<style>
  .collection-index { padding-block: var(--space-8); }
  .collection-index__header { display: grid; max-width: 48rem; gap: var(--space-4); margin-bottom: var(--space-7); }
  .collection-index__eyebrow, .collection-index__count { margin: 0; color: var(--text-muted); font-size: var(--text-sm); }
  .collection-index__eyebrow { color: var(--accent-system); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  h1 { margin: 0; font-size: var(--text-3xl); letter-spacing: -0.045em; line-height: 1; }
  .collection-index__header > p:not(.collection-index__eyebrow):not(.collection-index__count) { margin: 0; color: var(--text-secondary); font-size: var(--text-lg); }
  .collection-index__grid { display: grid; gap: var(--space-4); }
  @media (min-width: 48rem) { .collection-index__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
