---
interface Props {
  world?: string;
  ecosystemRole?: string;
  whatItProves?: string;
  boundaries?: string[];
}

const { world, ecosystemRole, whatItProves, boundaries = [] } = Astro.props;
const hasContent = Boolean(world || ecosystemRole || whatItProves || boundaries.length > 0);
---

{hasContent && (
  <section class="ecosystem-role" aria-labelledby="ecosystem-role-heading">
    <p class="eyebrow">Portfolio role</p>
    <h2 id="ecosystem-role-heading">{world ?? 'Ecosystem role'}</h2>
    {ecosystemRole && (
      <div class="ecosystem-role__item">
        <h3>Role in the ecosystem</h3>
        <p>{ecosystemRole}</p>
      </div>
    )}
    {whatItProves && (
      <div class="ecosystem-role__item">
        <h3>What this proves</h3>
        <p>{whatItProves}</p>
      </div>
    )}
    {boundaries.length > 0 && (
      <div class="ecosystem-role__item">
        <h3>Boundaries</h3>
        <ul>
          {boundaries.map((boundary) => <li>{boundary}</li>)}
        </ul>
      </div>
    )}
  </section>
)}

<style>
  .ecosystem-role { display: grid; gap: var(--space-4); margin-block: 0 var(--space-7); padding: var(--space-5); border: var(--border-width) solid var(--border-subtle); border-radius: var(--radius-md); background: var(--surface-raised); }
  .ecosystem-role > h2 { margin: 0; font-size: var(--text-xl); }
  .ecosystem-role__item { display: grid; gap: var(--space-2); }
  .ecosystem-role__item h3 { margin: 0; font-size: var(--text-base); }
  .ecosystem-role__item p { margin: 0; color: var(--text-secondary); }
  .ecosystem-role__item ul { display: grid; gap: var(--space-2); margin: 0; padding-left: var(--space-5); color: var(--text-secondary); }
</style>
