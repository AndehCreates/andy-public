---
import SystemDiagram from '@/components/diagrams/SystemDiagram.astro';
import { evidenceStateLabels, type DiagramConfiguration, type EvidenceSummary, type FlagshipTheme } from '@/lib/content/presentation';

interface Props {
  hook: string;
  problemContext: string;
  pivotalDecision: string;
  evidenceSummary: EvidenceSummary;
  theme: FlagshipTheme;
  artifactLabels: string[];
  diagram: DiagramConfiguration;
}

const {
  hook,
  problemContext,
  pivotalDecision,
  evidenceSummary,
  theme,
  artifactLabels,
  diagram,
} = Astro.props;

const methodLabels: Record<EvidenceSummary['evidenceMethod'], string> = {
  'test-execution': 'Test execution',
  'static-check': 'Static check',
  'source-inspection': 'Source inspection',
  none: 'Not yet validated',
};

---

<section
  class="case-study-hero"
  data-case-study-hero
  data-theme={theme}
  aria-label="Case study overview"
>
  <div class="case-study-hero__introduction">
    <p class="case-study-hero__eyebrow">Case study</p>
    <p class="case-study-hero__hook">{hook}</p>
    <ul class="case-study-hero__artifact-labels" aria-label="Artifact themes">
      {artifactLabels.map((label) => <li>{label}</li>)}
    </ul>
  </div>

  <dl class="case-study-hero__summary">
    <div>
      <dt>Problem and context</dt>
      <dd>{problemContext}</dd>
    </div>
    <div>
      <dt>Pivotal decision</dt>
      <dd>{pivotalDecision}</dd>
    </div>
    <div class="case-study-hero__evidence">
      <dt>Evidence basis</dt>
      <dd>
        <span>{methodLabels[evidenceSummary.evidenceMethod]} · {evidenceStateLabels[evidenceSummary.evidenceState]}</span>
        {evidenceSummary.evidenceScope}
      </dd>
    </div>
    <div class="case-study-hero__boundary">
      <dt>Evidence boundary</dt>
      <dd>Validation is limited to the stated scope and does not establish outcomes beyond it.</dd>
    </div>
  </dl>

  <div class="case-study-hero__diagram">
    <SystemDiagram diagram={diagram} theme={theme} headingLevel={2} compact />
  </div>
</section>

<style>
  .case-study-hero {
    --case-study-accent: var(--accent-authority);
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-7);
    padding: var(--space-5);
    border: var(--border-width) solid color-mix(in srgb, var(--case-study-accent) 28%, var(--border-subtle));
    border-radius: var(--radius-lg);
    background: linear-gradient(145deg, color-mix(in srgb, var(--case-study-accent) 8%, var(--surface-raised)), var(--surface-sunken));
  }
  .case-study-hero[data-theme='continuity'] { --case-study-accent: var(--accent-continuity); }
  .case-study-hero[data-theme='evidence'] { --case-study-accent: var(--accent-evidence); }
  .case-study-hero__introduction { display: grid; gap: var(--space-3); }
  .case-study-hero__eyebrow { color: var(--case-study-accent); font-size: var(--text-xs); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .case-study-hero__hook { max-width: 50rem; color: var(--text-primary); font-size: var(--text-xl); font-weight: 700; line-height: 1.25; }
  .case-study-hero__artifact-labels { display: flex; flex-wrap: wrap; gap: var(--space-2); list-style: none; }
  .case-study-hero__artifact-labels li { padding: var(--space-1) var(--space-3); border: var(--border-width) solid color-mix(in srgb, var(--case-study-accent) 45%, var(--border-subtle)); border-radius: 999px; color: var(--text-secondary); font-family: var(--font-mono); font-size: var(--text-xs); }
  .case-study-hero__summary { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--space-5); margin: 0; border-block: var(--border-width) solid var(--border-subtle); }
  .case-study-hero__summary > div { padding-block: var(--space-4); }
  .case-study-hero__summary > div:nth-child(n + 3) { border-top: var(--border-width) solid var(--border-subtle); }
  .case-study-hero__summary > div:nth-child(even) { padding-left: var(--space-5); border-left: var(--border-width) solid var(--border-subtle); }
  .case-study-hero__summary dt { color: var(--case-study-accent); font-size: var(--text-xs); font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .case-study-hero__summary dd { margin: var(--space-2) 0 0; color: var(--text-secondary); font-size: var(--text-sm); line-height: 1.55; }
  .case-study-hero__evidence dd span { display: block; margin-bottom: var(--space-1); color: var(--text-primary); font-family: var(--font-mono); font-size: var(--text-xs); }
  .case-study-hero__boundary { border-bottom: 2px solid var(--state-boundary); }
  .case-study-hero__diagram :global(.system-diagram) { margin: 0; }

  @media (min-width: 48.0625rem) {
    .case-study-hero { gap: var(--space-3); padding: var(--space-4); }
    .case-study-hero__introduction { grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: var(--space-2) var(--space-5); }
    .case-study-hero__eyebrow { grid-column: 1 / -1; }
    .case-study-hero__hook { font-size: 1.25rem; }
    .case-study-hero__summary > div { padding-block: var(--space-3); }
    .case-study-hero__diagram :global(.system-diagram--compact) { padding: var(--space-3); }
    .case-study-hero__diagram :global(.system-diagram--compact .system-diagram__header > p:last-child) { margin-top: var(--space-1); font-size: var(--text-sm); }
    .case-study-hero__diagram :global(.system-diagram--compact .system-diagram__visual) { margin-top: var(--space-3); padding: var(--space-2); }
    .case-study-hero__diagram :global(.system-diagram--compact .system-diagram__flow) { gap: var(--space-1); }
    .case-study-hero__diagram :global(.system-diagram--compact .system-diagram__node) { padding: var(--space-1) var(--space-2); font-size: var(--text-xs); }
    .case-study-hero__diagram :global(.system-diagram--compact .system-diagram__node small) { display: none; }
    .case-study-hero__diagram :global(.system-diagram--compact .system-diagram__connector) { font-size: .6875rem; }
    .case-study-hero__diagram :global(.system-diagram--compact .system-diagram__text) {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }

  @media (max-width: 48rem) {
    .case-study-hero { padding: var(--space-4); }
    .case-study-hero__summary { grid-template-columns: 1fr; }
    .case-study-hero__summary > div:nth-child(n + 2) { border-top: var(--border-width) solid var(--border-subtle); }
    .case-study-hero__summary > div:nth-child(even) { padding-left: 0; border-left: 0; }
  }
</style>
