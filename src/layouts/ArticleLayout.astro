---
import BaseLayout from './BaseLayout.astro';
import '@/styles/prose.css';

interface TocItem { depth: number; slug: string; text: string; }
interface Source { label: string; href?: string; }
interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  image?: string;
  robots?: string;
  updatedAt?: Date | string;
  sources?: Source[];
  tableOfContents?: TocItem[];
}

const { title, updatedAt, sources = [], tableOfContents = [] } = Astro.props;
const updatedLabel = updatedAt
  ? new Intl.DateTimeFormat('en', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(updatedAt))
  : undefined;
---

<BaseLayout {...Astro.props} type="article">
  <article class="article prose-container">
    <header class="article__header">
      <h1>{title}</h1>
      {(updatedLabel || sources.length > 0) && (
        <div class="article__metadata">
          {updatedLabel && <p>Updated <time datetime={new Date(updatedAt!).toISOString()}>{updatedLabel}</time></p>}
          {sources.length > 0 && <p>Sources: {sources.map((source, index) => <>{index > 0 && ', '}{source.href ? <a href={source.href}>{source.label}</a> : source.label}</>)}</p>}
        </div>
      )}
    </header>
    {(tableOfContents.length > 0 || Astro.slots.has('toc')) && (
      <aside class="article__toc" aria-label="Table of contents">
        <h2>On this page</h2>
        {Astro.slots.has('toc') ? <slot name="toc" /> : <ol>{tableOfContents.map((item) => <li class:list={{ 'article__toc--nested': item.depth > 2 }}><a href={`#${item.slug}`}>{item.text}</a></li>)}</ol>}
      </aside>
    )}
    <div class="prose"><slot /></div>
    {Astro.slots.has('related') && <aside class="article__related"><slot name="related" /></aside>}
  </article>
</BaseLayout>

<style>
  .article { padding-block: var(--space-8); }
  .article__header { margin-bottom: var(--space-7); }
  .article__header h1 { margin: 0; color: var(--text-primary); font-size: var(--text-3xl); line-height: 1.05; }
  .article__metadata { display: grid; gap: var(--space-2); margin-top: var(--space-4); color: var(--text-muted); font-size: var(--text-sm); }
  .article__metadata p { margin: 0; }
  .article__toc, .article__related { margin-block: var(--space-6); padding: var(--space-4); border: var(--border-width) solid var(--border-subtle); border-radius: var(--radius-md); background: var(--surface-raised); }
  .article__toc h2 { margin: 0 0 var(--space-3); color: var(--text-primary); font-size: var(--text-base); }
  .article__toc ol { margin: 0; padding-left: var(--space-4); }
  .article__toc--nested { margin-left: var(--space-3); }
</style>
