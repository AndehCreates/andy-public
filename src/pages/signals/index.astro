---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { publicEntries } from '@/lib/content/queries';
import { capabilities } from '@/lib/content/taxonomy';
import { withBase } from '@/config/site';

const signals = publicEntries((await getCollection('signals')).map((entry) => ({
  title: entry.data.title,
  visibility: entry.data.visibility,
  publicReview: entry.data.publicReview,
  ...(entry.data.order === undefined ? {} : { order: entry.data.order }),
  entry,
}))).map(({ entry }) => entry);
const kindLabel = { resource: 'Resource', homelab: 'Homelab', 'field-note': 'Field note', experiment: 'Experiment' } as const;
const signalGroups = [
  { kind: 'resource', title: 'Resource' },
  { kind: 'homelab', title: 'Homelab' },
  { kind: 'field-note', title: 'Field notes' },
  { kind: 'experiment', title: 'Experiments' },
] as const;
---

<BaseLayout title="Signal Library | Andy — Human Capability Systems" description="Annotated resources, homelab notes, field notes, and experiments around reliable human-centered systems." canonicalPath="/signals/">
  <section class="signals container" aria-labelledby="signals-heading">
    <header>
      <p>Annotated references and experiments</p>
      <h1 id="signals-heading">Signal Library</h1>
      <p>Useful material from the edges of the work: practical resources, local infrastructure patterns, field notes, and small experiments with a clear reason for being here.</p>
    </header>
    <div class="signals__groups">
      {signalGroups.map((group) => {
        const entries = signals.filter((entry) => entry.data.kind === group.kind);
        return entries.length > 0 && <section class="signals__group" aria-labelledby={`signals-${group.kind}`}>
          <h2 id={`signals-${group.kind}`}>{group.title}</h2>
          <div class="signals__grid">
            {entries.map((entry) => <article>
              <p>{kindLabel[entry.data.kind]} - {capabilities[entry.data.capabilities.at(0) ?? 'ai-systems']}</p>
              <h3><a href={withBase(`/signals/${entry.id}/`)}>{entry.data.title}</a></h3>
              <p>{entry.data.summary}</p>
              <a href={withBase(`/signals/${entry.id}/`)}>Read the annotation</a>
            </article>)}
          </div>
        </section>;
      })}
    </div>
  </section>
</BaseLayout>

<style>
  .signals { padding-block: var(--space-8); }
  header, article { display: grid; gap: var(--space-3); }
  .signals > header { max-width: 48rem; margin-bottom: var(--space-7); }
  header p, article p { margin: 0; color: var(--text-secondary); }
  .signals > header > p:first-child, article > p:first-child { color: var(--accent-signal); font-size: var(--text-sm); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  h1, h2, h3 { margin: 0; color: var(--text-primary); }
  h1 { font-size: var(--text-3xl); letter-spacing: -.045em; line-height: 1; }
  h2 { font-size: var(--text-xl); }
  .signals__groups { display: grid; gap: var(--space-7); }
  .signals__group { display: grid; gap: var(--space-4); }
  .signals__grid { display: grid; gap: var(--space-4); }
  article { align-content: start; padding: var(--space-5); border: var(--border-width) solid var(--border-subtle); border-radius: var(--radius-md); background: var(--surface-raised); }
  article a { color: var(--accent-signal); }
  @media (min-width: 48rem) { .signals__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
