---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { resume } from '@/data/resume';
import { withBase } from '@/config/site';
---

<BaseLayout
  title="Resume | Andy - Human Capability Systems"
  description="A concise resume of systems-oriented software work, capabilities, and verified technical tools."
  canonicalPath="/resume/"
  imageAlt="Andy - Human Capability Systems resume, with capabilities and selected systems."
>
  <article class="resume prose-container" aria-labelledby="resume-heading">
    <header class="resume__header">
      <div>
        <p class="eyebrow">Career overview</p>
        <h1 id="resume-heading">Resume</h1>
        <p>{resume.summary}</p>
      </div>
      <button class="print-action" type="button" data-print-resume>Print / Save as PDF</button>
    </header>

    <section aria-labelledby="capabilities-heading">
      <h2 id="capabilities-heading">Capabilities</h2>
      <div class="resume__groups">
        {resume.capabilityGroups.map((group) => (
          <section>
            <h3>{group.title}</h3>
            <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
          </section>
        ))}
      </div>
    </section>

    <section aria-labelledby="systems-heading">
      <h2 id="systems-heading">Selected systems</h2>
      <div class="resume__systems">
        {resume.selectedSystems.map((system) => (
          <section>
            <h3><a href={withBase(system.href)}>{system.title}</a></h3>
            <p>{system.summary}</p>
          </section>
        ))}
      </div>
    </section>

    <section aria-labelledby="tools-heading">
      <h2 id="tools-heading">Technical tools used</h2>
      <ul class="resume__tools">{resume.technicalTools.map((tool) => <li>{tool}</li>)}</ul>
    </section>
  </article>
</BaseLayout>

<script>
  document.querySelector('[data-print-resume]')?.addEventListener('click', () => window.print());
</script>

<style>
  .resume { display: grid; gap: var(--space-8); padding-block: var(--space-8); }
  .resume__header { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-5); padding-bottom: var(--space-6); border-bottom: var(--border-width) solid var(--border-subtle); }
  .resume__header > div { display: grid; max-width: 45rem; gap: var(--space-3); }
  .eyebrow { color: var(--accent-system); font-size: var(--text-sm); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  h1, h2, h3 { margin: 0; color: var(--text-primary); }
  h1 { font-size: var(--text-3xl); letter-spacing: -.045em; line-height: 1; }
  h2 { margin-bottom: var(--space-4); font-size: var(--text-xl); }
  h3 { font-size: var(--text-base); }
  .resume p, .resume li { color: var(--text-secondary); }
  .print-action { padding: var(--space-2) var(--space-3); border: var(--border-width) solid var(--border-strong); border-radius: var(--radius-sm); background: transparent; color: var(--text-primary); }
  .resume__groups, .resume__systems { display: grid; gap: var(--space-4); }
  .resume__groups > section, .resume__systems > section { display: grid; gap: var(--space-3); padding: var(--space-4); border: var(--border-width) solid var(--border-subtle); border-radius: var(--radius-md); background: var(--surface-raised); }
  .resume ul { display: grid; gap: var(--space-2); padding-left: var(--space-5); }
  .resume__tools { grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); }
  .resume__tools li { padding-left: var(--space-1); }
  .resume a { color: var(--accent-system); }
  @media (min-width: 48rem) { .resume__groups, .resume__systems { grid-template-columns: repeat(2, minmax(0, 1fr)); } .resume__systems > section:last-child { grid-column: 1 / -1; } }
  @media print { .print-action, :global(.site-header), :global(.site-footer), :global(.skip-link) { display: none; } .resume { padding: 0; } .resume__groups > section, .resume__systems > section { break-inside: avoid; background: transparent; } }
</style>
