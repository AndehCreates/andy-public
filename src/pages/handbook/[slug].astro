---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { publicEntries } from '@/lib/content/queries';

export async function getStaticPaths() {
  const entries = await getCollection('handbook');
  return publicEntries(entries.map((entry) => ({
    title: entry.data.title,
    visibility: entry.data.visibility,
    publicReview: entry.data.publicReview,
    ...(entry.data.order === undefined ? {} : { order: entry.data.order }),
    entry,
  }))).map(({ entry }) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'handbook'>; }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<ArticleLayout title={entry.data.title} description={entry.data.summary} canonicalPath={`/handbook/${entry.id}/`} updatedAt={entry.data.updatedAt} tableOfContents={headings}>
  <Content />
</ArticleLayout>
