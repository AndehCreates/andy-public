---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { approvedHomepageFeaturedProjects, publicEntries } from '@/lib/content/queries';
import { evidenceStateLabels } from '@/lib/content/presentation';

const [projects, handbook, signals] = await Promise.all([
  getCollection('projects'),
  getCollection('handbook'),
  getCollection('signals'),
]);

const featuredProjects = approvedHomepageFeaturedProjects(projects.map((entry) => ({
  id: entry.id,
  title: entry.data.title,
  visibility: entry.data.visibility,
  publicReview: entry.data.publicReview,
  ...(entry.data.order === undefined ? {} : { order: entry.data.order }),
  entry,
}))).map(({ entry }) => entry);

const handbookTeasers = publicEntries(handbook.map((entry) => ({
  title: entry.data.title,
  visibility: entry.data.visibility,
  publicReview: entry.data.publicReview,
  ...(entry.data.order === undefined ? {} : { order: entry.data.order }),
  entry,
}))).slice(0, 2).map(({ entry }) => entry);

const signalTeasers = publicEntries(signals.map((entry) => ({
  title: entry.data.title,
  visibility: entry.data.visibility,
  publicReview: entry.data.publicReview,
  ...(entry.data.order === undefined ? {} : { order: entry.data.order }),
  entry,
}))).slice(0, 3).map(({ entry }) => entry);

const principles = [
  ['Grounded knowledge', 'Important outputs should trace to trusted sources, durable context, or inspectable system state.'],
  ['Human-owned decisions', 'Consequential actions stay understandable, reviewable, and interruptible by people.'],
  ['Modular architecture', 'Components keep explicit responsibilities so their boundaries remain replaceable and clear.'],
  ['Evaluation-driven development', 'Tests, observed behavior, and visible failure modes matter more than a convincing demo.'],
] as const;

type ReviewedOutcomeSystem = {
  id: 'chief-of-staff' | 'lifeos' | 'alpha-screener';
  name: 'Chief of Staff' | 'LifeOS' | 'Alpha Screener';
  sequenceLabel: '01' | '02' | '03';
  outcome: string;
};

const reviewedOutcomeSystems: readonly ReviewedOutcomeSystem[] = [
  {
    id: 'chief-of-staff',
    name: 'Chief of Staff',
    sequenceLabel: '01',
    outcome: 'Coordinate AI-assisted work without losing review clarity or control of the decision boundary.',
  },
  {
    id: 'lifeos',
    name: 'LifeOS',
    sequenceLabel: '02',
    outcome: 'Make intentions workable in the time that is actually available.',
  },
  {
    id: 'alpha-screener',
    name: 'Alpha Screener',
    sequenceLabel: '03',
    outcome: 'Evaluate uncertain research with clearer assumptions, tradeoffs, and space for human judgment.',
  },
] as const;

const reviewedOutcomeLookup = new Map(reviewedOutcomeSystems.map((system) => {
  const [verb, ...outcomeWords] = system.outcome.split(' ');

  return [system.id, {
    sequenceLabel: system.sequenceLabel,
    verb,
    outcome: outcomeWords.join(' '),
  }] as const;
}));

---

<BaseLayout
  title="Andy — AI Systems"
  description="Evidence-led software and AI systems built to strengthen human capability."
  canonicalPath="/"
>
  <section class="home-hero container" aria-labelledby="home-title">
    <div class="home-hero__position">
      <p class="eyebrow">Evidence-led AI systems</p>
      <h1 id="home-title">Software that strengthens human capability.</h1>
      <p class="home-hero__identity">Andy builds evidence-led AI systems and human-centered software through a practice of explicit authority, durable context, and bounded validation.</p>
      <div class="home-hero__actions">
        <a class="action action--primary" href="/case-studies/">Read case studies</a>
      </div>
      <p class="home-hero__summary">Systems for coordinating AI-assisted work, making intentions workable in real time, and evaluating uncertain research while keeping judgment and tradeoffs visible.</p>
      <nav class="home-hero__secondary" aria-label="Secondary homepage actions">
        <a href="/handbook/">Explore the handbook</a>
        <a href="mailto:hello@andehcreates.com">Contact Andy</a>
      </nav>
      <p class="opportunity">Open to roles and thoughtful collaboration.</p>
    </div>
    <aside class="home-hero__outcomes" data-outcomes-module aria-labelledby="outcomes-heading">
      <div class="home-hero__outcomes-header">
        <p class="eyebrow">Reviewed outcomes</p>
        <h2 id="outcomes-heading">What the work helps people do</h2>
        <p>Three systems, framed by the practical outcome each one is meant to improve.</p>
      </div>
      <ol class="home-hero__outcomes-list">
        {reviewedOutcomeSystems.map((system) => <li class="home-hero__outcome-row" data-outcome-system={system.id}>
          <span class="home-hero__outcome-sequence" aria-hidden="true">{system.sequenceLabel}</span>
          <div class="home-hero__outcome-copy">
            <p class="home-hero__outcome-line">
              <strong data-outcome-system-name>{system.name}</strong>
              <span>{system.outcome}</span>
            </p>
          </div>
        </li>)}
      </ol>
    </aside>
  </section>

  <section id="principles" class="principles container" aria-labelledby="principles-heading">
    <header class="section-heading">
      <p class="eyebrow">A working philosophy</p>
      <h2 id="principles-heading">Engineering principles</h2>
    </header>
    <div class="principles__grid">
      {principles.map(([title, description], index) => <article>
        <p class="principles__number">0{index + 1}</p>
        <h3>{title}</h3>
        <p>{description}</p>
      </article>)}
    </div>
  </section>

  <section id="featured-systems" class="featured container" aria-labelledby="featured-heading">
    <header class="section-heading section-heading--split">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 id="featured-heading">Featured systems</h2>
        <p class="featured__intro">Three different systems, one shared standard: make the decision boundary as inspectable as the result.</p>
      </div>
      <a href="/case-studies/">Read the case studies</a>
    </header>
    <div class="featured__grid">
      {featuredProjects.map((project, index) => {
        const reviewedOutcome = reviewedOutcomeLookup.get(project.id as ReviewedOutcomeSystem['id']);

        return <article class:list={['flagship-preview', index === 0 && 'flagship-preview--lead']} data-flagship-preview data-theme={project.data.theme}>
        <div class="flagship-preview__eyebrow">
          <p class="flagship-preview__sequence-line">
            <span data-feature-sequence>{reviewedOutcome?.sequenceLabel}</span>
            <span class="flagship-preview__rail" data-feature-rail aria-hidden="true"></span>
            <span data-feature-verb>{reviewedOutcome?.verb}</span>
          </p>
        </div>
        <div class="flagship-preview__heading">
          <h3><a href={`/case-studies/${project.id}/`}>{project.data.title}</a></h3>
          <p class="flagship-preview__hook" data-feature-outcome>{reviewedOutcome?.outcome}</p>
        </div>
        <dl class="flagship-preview__details">
          <div>
            <dt>Decision</dt>
            <dd>{project.data.pivotalDecision}</dd>
          </div>
          <div>
            <dt>Evidence</dt>
            <dd><strong>{evidenceStateLabels[project.data.evidenceSummary!.evidenceState]}</strong> · {project.data.evidenceSummary!.evidenceScope}</dd>
          </div>
        </dl>
        <a class="flagship-preview__link" href={`/case-studies/${project.id}/`}>Explore the case study</a>
      </article>;
      })}
    </div>
  </section>

  <section id="signal-library" class="signals" aria-labelledby="signals-heading">
    <div class="container signals__inner">
      <header class="section-heading">
        <p class="eyebrow">A living collection</p>
        <h2 id="signals-heading">Signal Library</h2>
        <p>Annotated resources, homelab notes, field observations, and experiments that inform the work without narrowing the portfolio to a single discipline.</p>
      </header>
      <div class="signals__grid">
        {signalTeasers.map((signal) => <article>
          <p>{signal.data.kind.replace('-', ' ')}</p>
          <h3><a href={`/signals/${signal.id}/`}>{signal.data.title}</a></h3>
          <p>{signal.data.summary}</p>
        </article>)}
      </div>
      <a class="action action--signal" href="/signals/">Visit the Signal Library</a>
    </div>
  </section>

  <section class="paths container" aria-labelledby="paths-heading">
    <header class="section-heading">
      <p class="eyebrow">Keep exploring</p>
      <h2 id="paths-heading">Handbook and wider work</h2>
    </header>
    <div class="paths__grid">
      <article>
        <p class="eyebrow">Reusable patterns</p>
        <h3>Engineering handbook</h3>
        <p>Principles, failure modes, and practical checklists for building systems that remain inspectable as their context changes.</p>
        <ul>
          {handbookTeasers.map((entry) => <li><a href={`/handbook/${entry.id}/`}>{entry.data.title}</a></li>)}
        </ul>
        <a href="/handbook/">Explore the handbook</a>
      </article>
      <article>
        <p class="eyebrow">Full project atlas</p>
        <h3>Work across systems</h3>
        <p>See supporting projects, system maps, and the wider set of experiments that sharpen the central practice.</p>
        <a href="/work/">View all work</a>
        <a href="/systems/">Browse system maps</a>
      </article>
    </div>
  </section>

  <section class="conversation container" aria-labelledby="conversation-heading">
    <p class="eyebrow">A useful next step</p>
    <h2 id="conversation-heading">Start a conversation</h2>
    <p>If you are hiring for systems-minded engineering, shaping an AI-assisted workflow, or exploring software that helps people think and recover context, I would welcome the conversation.</p>
    <a class="action action--primary" href="mailto:hello@andehcreates.com">Discuss a role or system</a>
  </section>
</BaseLayout>

<style>
  .home-hero { display: grid; align-items: center; min-height: min(76vh, 52rem); gap: var(--space-6); padding-block: var(--space-7); }
  .home-hero__position { display: grid; align-content: center; gap: var(--space-4); min-width: 0; }
  .home-hero__position > * { animation: rise-in var(--motion-slow) var(--motion-ease) both; }
  .home-hero__position > :nth-child(2) { animation-delay: 45ms; }
  .home-hero__position > :nth-child(3) { animation-delay: 90ms; }
  .home-hero__position > :nth-child(4) { animation-delay: 135ms; }
  .home-hero__position > :nth-child(5) { animation-delay: 180ms; }
  .home-hero__outcomes { display: grid; gap: var(--space-3); min-width: 0; padding: var(--space-4); border: var(--border-width) solid color-mix(in srgb, var(--accent-system) 38%, var(--border-subtle)); border-radius: var(--radius-lg); background: linear-gradient(155deg, color-mix(in srgb, var(--accent-system) 8%, var(--surface-raised)), var(--surface-raised) 52%); animation: settle-in calc(var(--motion-slow) * 1.4) var(--motion-ease) 150ms both; font-size: 0; line-height: 0; }
  .home-hero__outcomes-header { display: grid; gap: var(--space-2); }
  .home-hero__outcomes-header .eyebrow { line-height: 1.2; }
  .home-hero__outcomes-header h2 { line-height: 1.05; }
  .home-hero__outcomes-header > p:last-child { margin: 0; color: var(--text-secondary); font-size: var(--text-base); }
  .home-hero__outcomes-list { display: grid; gap: var(--space-2); margin: 0; padding: 0; list-style: none; font-size: 0; line-height: 0; }
  .home-hero__outcome-row { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-3); align-items: start; padding: var(--space-2) var(--space-3); border: var(--border-width) solid var(--border-subtle); border-radius: var(--radius-md); background: color-mix(in srgb, var(--surface-sunken) 72%, var(--surface-raised)); }
  .home-hero__outcome-sequence { display: inline-flex; align-items: center; justify-content: center; min-width: 2.5rem; min-height: 2.5rem; border: var(--border-width) solid color-mix(in srgb, var(--accent-system) 42%, var(--border-subtle)); border-radius: var(--radius-sm); color: var(--accent-system); font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700; letter-spacing: .08em; }
  .home-hero__outcome-copy { min-width: 0; }
  .home-hero__outcome-line { margin: 0; color: var(--text-secondary); font-size: var(--text-base); }
  .home-hero__outcome-line strong { color: var(--text-primary); font-size: var(--text-lg); font-weight: 650; }
  .home-hero__outcome-line span { color: inherit; }
  .eyebrow, .principles__number, .signals__grid article > p:first-child { margin: 0; color: var(--accent-system); font-size: var(--text-xs); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  h1, h2, h3 { margin: 0; color: var(--text-primary); }
  h1 { max-width: 15ch; font-size: var(--text-3xl); line-height: 1; letter-spacing: -0.045em; }
  h2 { font-size: var(--text-2xl); line-height: 1.05; letter-spacing: -.03em; }
  h3 { font-size: var(--text-xl); line-height: 1.15; }
  .home-hero__identity { max-width: 43rem; margin: 0; color: var(--text-primary); font-size: var(--text-lg); font-weight: 650; }
  .home-hero__summary, .section-heading > p:last-child, .principles article > p:last-child, .signals__grid article > p:last-child, .paths article > p:not(.eyebrow), .conversation > p:not(.eyebrow) { max-width: 46rem; margin: 0; color: var(--text-secondary); font-size: var(--text-lg); }
  .home-hero__actions, .section-heading--split, .paths article, .conversation { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .action { display: inline-flex; align-items: center; min-height: 44px; padding: var(--space-2) var(--space-4); border: var(--border-width) solid var(--border-strong); border-radius: var(--radius-sm); color: var(--text-primary); font-weight: 700; text-decoration: none; transition: background-color var(--motion-base) var(--motion-ease), border-color var(--motion-base) var(--motion-ease), color var(--motion-base) var(--motion-ease), transform var(--motion-fast) var(--motion-ease); }
  .action:hover { border-color: var(--accent-system); background: var(--surface-raised); }
  .action:active { transform: translateY(1px); }
  .action--primary { border-color: var(--accent-system); background: var(--accent-system); color: var(--surface-sunken); }
  .action--primary:hover { color: var(--surface-sunken); background: #8ce2f2; }
  .home-hero__secondary { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); }
  .home-hero__secondary a { display: inline-flex; align-items: center; min-width: 44px; min-height: 44px; color: var(--text-secondary); font-size: var(--text-sm); text-underline-offset: .2em; }
  .home-hero__secondary a:hover { color: var(--text-primary); }
  .opportunity { margin: var(--space-3) 0 0; color: var(--text-muted); font-size: var(--text-sm); }
  .principles, .featured, .paths { padding-block: var(--space-9); }
  .section-heading { display: grid; gap: var(--space-3); max-width: 50rem; margin-bottom: var(--space-6); }
  .section-heading--split { max-width: none; justify-content: space-between; }
  .section-heading--split > a { color: var(--accent-system); }
  .featured__intro { max-width: 42rem; margin: var(--space-3) 0 0; color: var(--text-secondary); }
  .principles__grid, .featured__grid, .paths__grid, .signals__grid { display: grid; gap: var(--space-4); }
  .principles article, .paths article, .signals__grid article { display: grid; align-content: start; gap: var(--space-3); padding: var(--space-5); border: var(--border-width) solid var(--border-subtle); border-radius: var(--radius-md); background: var(--surface-raised); }
  .principles article > p:last-child, .signals__grid article > p:last-child, .paths article > p:not(.eyebrow) { font-size: var(--text-base); }
  .paths article ul { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; list-style: none; }
  .paths a { color: var(--accent-system); }
  .flagship-preview { --flagship-accent: var(--accent-authority); display: grid; align-content: start; gap: var(--space-4); min-width: 0; min-height: 100%; padding: var(--space-5); overflow: hidden; border: var(--border-width) solid color-mix(in srgb, var(--flagship-accent) 38%, var(--border-subtle)); border-radius: var(--radius-md); background: linear-gradient(145deg, color-mix(in srgb, var(--flagship-accent) 7%, var(--surface-raised)), var(--surface-raised) 48%); transition: border-color var(--motion-base) var(--motion-ease), background-color var(--motion-base) var(--motion-ease), transform var(--motion-base) var(--motion-ease); }
  .flagship-preview--lead { border-color: color-mix(in srgb, var(--flagship-accent) 62%, var(--border-subtle)); }
  .flagship-preview[data-theme='continuity'] { --flagship-accent: var(--accent-continuity); }
  .flagship-preview[data-theme='evidence'] { --flagship-accent: var(--accent-evidence); }
  .flagship-preview__eyebrow { display: grid; gap: var(--space-2); }
  .flagship-preview__sequence-line { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); margin: 0; color: var(--flagship-accent); font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .flagship-preview__rail { display: inline-flex; width: 3rem; height: 1px; background: color-mix(in srgb, var(--flagship-accent) 58%, var(--border-subtle)); }
  .flagship-preview__heading { display: grid; gap: var(--space-2); }
  .flagship-preview h3 a { color: var(--text-primary); text-decoration-color: color-mix(in srgb, var(--flagship-accent) 65%, transparent); text-underline-offset: .16em; }
  .flagship-preview__hook { margin: 0; color: var(--text-primary); font-size: var(--text-lg); overflow-wrap: anywhere; }
  .flagship-preview__details { display: grid; gap: var(--space-3); margin: 0; }
  .flagship-preview__details > div { display: grid; gap: var(--space-1); padding-top: var(--space-3); border-top: var(--border-width) solid var(--border-subtle); }
  .flagship-preview__details dt { color: var(--flagship-accent); font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .flagship-preview__details dd { margin: 0; color: var(--text-secondary); font-size: var(--text-sm); overflow-wrap: anywhere; }
  .flagship-preview__details strong { color: var(--text-primary); font-weight: 650; }
  .flagship-preview__link { display: inline-flex; align-items: center; width: fit-content; min-width: 44px; min-height: 44px; margin-top: auto; color: var(--flagship-accent); font-weight: 700; }
  .signals { padding-block: var(--space-9); border-block: var(--border-width) solid color-mix(in srgb, var(--accent-signal) 40%, var(--border-subtle)); background: linear-gradient(135deg, #16122a 0%, var(--surface-canvas) 72%); }
  .signals .eyebrow, .signals__grid article > p:first-child { color: var(--accent-signal); }
  .signals__inner { display: grid; gap: var(--space-5); }
  .signals__inner .section-heading { margin-bottom: 0; }
  .signals__grid article { background: color-mix(in srgb, var(--surface-raised) 84%, var(--accent-signal)); }
  .action--signal { justify-self: start; border-color: var(--accent-signal); }
  .action--signal:hover { border-color: var(--accent-signal); color: var(--accent-signal); }
  .paths__grid > article { min-height: 100%; }
  .paths article { grid-template-columns: 1fr; }
  .paths article > a { width: fit-content; }
  .conversation { align-items: flex-start; flex-direction: column; margin-bottom: var(--space-9); padding: var(--space-7); border: var(--border-width) solid var(--border-strong); border-radius: var(--radius-lg); background: var(--surface-raised); }
  /* Keep text at full contrast throughout entrance motion. */
  @keyframes rise-in { from { transform: translateY(.65rem); } to { transform: translateY(0); } }
  @keyframes settle-in { from { transform: translateY(1rem); } to { transform: translateY(0); } }
  @media (hover: hover) {
    .flagship-preview:hover { border-color: color-mix(in srgb, var(--flagship-accent) 72%, var(--border-subtle)); transform: translateY(-.25rem); }
  }
  @media (min-width: 64rem) {
    .home-hero { grid-template-columns: minmax(0, .92fr) minmax(30rem, 1.08fr); align-items: start; min-height: auto; padding-block: var(--space-3); }
    .home-hero__position { gap: var(--space-3); }
    .home-hero__identity, .home-hero__summary { font-size: var(--text-base); }
    .home-hero__outcomes { align-self: stretch; gap: var(--space-2); padding: var(--space-3); width: calc(100% / .88); transform: scale(.88); transform-origin: top left; animation: none; }
    .home-hero__outcomes-header { gap: var(--space-1); }
    .home-hero__outcomes-header h2 { font-size: var(--text-xl); line-height: 1.1; }
    .home-hero__outcomes-header > p:last-child { display: none; }
    .home-hero__outcomes-list { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; }
    .home-hero__outcome-row { grid-template-columns: 2rem minmax(0, 1fr); gap: var(--space-2); padding: var(--space-2); }
    .home-hero__outcome-row:first-child { grid-column: 1 / -1; }
    .home-hero__outcome-line { font-size: var(--text-sm); }
    .home-hero__outcome-line strong { margin-right: var(--space-2); font-size: var(--text-sm); }
  }
  @media (min-width: 48rem) {
    .principles__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .featured__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .flagship-preview--lead { grid-column: 1 / -1; grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); }
    .flagship-preview--lead .flagship-preview__details,
    .flagship-preview--lead .flagship-preview__link { grid-column: 2; }
    .paths__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .signals__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
