---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import CapabilityTag from '@/components/content/CapabilityTag.astro';
import CaseStudyHero from '@/components/content/CaseStudyHero.astro';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { canPublish } from '@/lib/content/publication';
import { featuredEntries } from '@/lib/content/queries';

export async function getStaticPaths() {
  const [entries, projects] = await Promise.all([
    getCollection('caseStudies'),
    getCollection('projects'),
  ]);
  const projectsById = new Map(
    projects.filter((project) => canPublish(project.data)).map((project) => [project.data.id, project]),
  );
  const studies = featuredEntries(entries.map((entry) => ({
    visibility: entry.data.visibility,
    publicReview: entry.data.publicReview,
    title: entry.data.title,
    ...(entry.data.order === undefined ? {} : { order: entry.data.order }),
    entry,
  })));

  return studies.map(({ entry }) => {
    const project = projectsById.get(entry.data.projectId);
    if (!project) {
      throw new Error(
        `Case study ${entry.id} references a missing or unpublished project ${entry.data.projectId}.`,
      );
    }
    return { params: { slug: entry.id }, props: { study: entry, project } };
  });
}

interface Props {
  study: CollectionEntry<'caseStudies'>;
  project: CollectionEntry<'projects'>;
}

const { study, project } = Astro.props;
const { Content } = await render(study);
const sourceLinks = study.data.sourceAvailability === 'public'
  ? study.data.sourceUrls.map((href) => ({ label: 'Project source', href }))
  : [];
---

<ArticleLayout
  title={study.data.title}
  description={study.data.summary}
  canonicalPath={`/case-studies/${study.id}/`}
  updatedAt={study.data.updatedAt}
  sources={sourceLinks}
  variant="case-study"
>
  <CaseStudyHero
    slot="lead"
    hook={project.data.caseStudyHook!}
    problemContext={study.data.summary}
    pivotalDecision={project.data.pivotalDecision!}
    evidenceSummary={project.data.evidenceSummary!}
    theme={project.data.theme!}
    artifactLabels={project.data.artifactLabels!}
    diagram={project.data.diagram!}
  />
  <ul class="case-study-capabilities" aria-label="Capabilities">
    {study.data.capabilities.map((capability) => <li><CapabilityTag capability={capability} /></li>)}
  </ul>
  <Content />
  <p class="related-project"><a href={`/work/${study.data.projectId.replace('project-', '')}/`}>View the related project</a></p>
</ArticleLayout>

<style>
  .case-study-capabilities { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; list-style: none; }
  .related-project { margin-top: var(--space-7); }
</style>
