---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { byOrderThenTitle, publicEntries } from '@/lib/content/queries';
import ProjectFilter, { type ProjectFilterProject } from '@/components/interactive/ProjectFilter';

function projectForPublication(entry: CollectionEntry<'projects'>) {
  const { visibility, publicReview, title, order } = entry.data;
  return { visibility, publicReview, title, ...(order === undefined ? {} : { order }), entry };
}

const projects = publicEntries((await getCollection('projects')).map(projectForPublication))
  .sort(byOrderThenTitle)
  .map(({ entry }): ProjectFilterProject => {
    const { workHook, visualMark, technicalDifferentiator } = entry.data;

    if (!workHook || !visualMark || !technicalDifferentiator) {
      throw new Error(`Published project ${entry.id} is missing required Work presentation data.`);
    }

    return {
      slug: entry.id,
      title: entry.data.title,
      summary: entry.data.summary,
      status: entry.data.status,
      workHook,
      visualMark,
      technicalDifferentiator,
      capabilities: entry.data.capabilities,
    };
  });
---

<BaseLayout
  title="Work | Andy — AI Systems"
  description="A project atlas of reviewed software and AI systems built around visible context, reliable decisions, and human control."
  canonicalPath="/work/"
>
  <ProjectFilter client:load projects={projects} />
  <script is:inline>
    (() => {
      const root = document.querySelector('[data-project-filter-root]');
      if (!(root instanceof HTMLElement)) {
        return;
      }

      const filterButtons = [...root.querySelectorAll('[data-filter-capability]')];
      const clearButton = root.querySelector('[data-filter-clear]');
      const countNode = root.querySelector('[data-filter-count]');
      const cards = [...root.querySelectorAll('[data-project-card]')];

      const countLabel = (count) => `${count} ${count === 1 ? 'project' : 'projects'} shown`;

      const applySelection = (selectedCapability) => {
        root.dataset.selectedCapability = selectedCapability ?? '';

        filterButtons.forEach((button) => {
          if (!(button instanceof HTMLElement)) {
            return;
          }

          button.setAttribute(
            'aria-pressed',
            String(button.dataset.filterCapability === selectedCapability),
          );
        });

        if (clearButton instanceof HTMLButtonElement) {
          clearButton.disabled = !selectedCapability;
        }

        let visibleCount = 0;

        cards.forEach((card) => {
          if (!(card instanceof HTMLElement)) {
            return;
          }

          const capabilityIds = (card.dataset.projectCapabilities ?? '').split(' ').filter(Boolean);
          const isVisible = !selectedCapability || capabilityIds.includes(selectedCapability);

          card.dataset.projectVisible = String(isVisible);
          card.hidden = !isVisible;

          if (isVisible) {
            visibleCount += 1;
          }
        });

        if (countNode instanceof HTMLElement) {
          countNode.textContent = countLabel(visibleCount);
        }
      };

      const handleClick = (event) => {
        const target = event.target;
        if (!(target instanceof Element)) {
          return;
        }

        const capabilityButton = target.closest('[data-filter-capability]');
        if (capabilityButton instanceof HTMLElement) {
          applySelection(capabilityButton.dataset.filterCapability ?? null);
          return;
        }

        const clearFilterButton = target.closest('[data-filter-clear]');
        if (clearFilterButton instanceof HTMLButtonElement && !clearFilterButton.disabled) {
          applySelection(null);
        }
      };

      const handleHydrated = () => {
        root.removeEventListener('click', handleClick);
        delete root.dataset.projectFilterInlineActive;
      };

      root.dataset.projectFilterInlineActive = 'true';
      root.addEventListener('click', handleClick);
      root.addEventListener('project-filter:hydrated', handleHydrated, { once: true });

      applySelection(root.dataset.selectedCapability || null);
    })();
  </script>
</BaseLayout>
