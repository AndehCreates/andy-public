---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { byOrderThenTitle, publicEntries } from '@/lib/content/queries';
import ProjectFilter, { type ProjectFilterProject } from '@/components/interactive/ProjectFilter';

function projectForPublication(entry: CollectionEntry<'projects'>) {
  const { visibility, publicReview, title, order } = entry.data;
  return { visibility, publicReview, title, ...(order === undefined ? {} : { order }), entry };
}

const projects = publicEntries((await getCollection('projects')).map(projectForPublication))
  .sort(byOrderThenTitle)
  .map(({ entry }): ProjectFilterProject => {
    const { workHook, visualMark, technicalDifferentiator } = entry.data;

    if (!workHook || !visualMark || !technicalDifferentiator) {
      throw new Error(`Published project ${entry.id} is missing required Work presentation data.`);
    }

    return {
      slug: entry.id,
      title: entry.data.title,
      summary: entry.data.summary,
      status: entry.data.status,
      workHook,
      visualMark,
      technicalDifferentiator,
      capabilities: entry.data.capabilities,
      ...(entry.data.world ? { world: entry.data.world } : {}),
    };
  });
---

<BaseLayout
  title="Work | Andy — Human Capability Systems"
  description="A project atlas of reviewed software and AI systems built around visible context, reliable decisions, and human control."
  canonicalPath="/work/"
>
  <ProjectFilter client:load projects={projects} />
</BaseLayout>
