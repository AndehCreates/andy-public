---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import CapabilityTag from '@/components/content/CapabilityTag.astro';
import CatalogArticleLayout from '@/layouts/CatalogArticleLayout.astro';
import { publicEntries } from '@/lib/content/queries';
import { resolveRelationshipPathways, type RelationshipTarget } from '@/lib/content/relations';

const collectionRoute = { projects: '/work/', caseStudies: '/case-studies/', handbook: '/handbook/', signals: '/signals/', systems: '/systems/' } as const;

async function relationshipTargets(): Promise<Map<string, RelationshipTarget>> {
  const collections = await Promise.all((Object.keys(collectionRoute) as Array<keyof typeof collectionRoute>).map(async (collection) => [collection, await getCollection(collection)] as const));
  return new Map(collections.flatMap(([collection, entries]) => entries.map((entry) => [`${collection}:${entry.data.id}`, { id: `${collection}:${entry.data.id}`, title: entry.data.title, href: `${collectionRoute[collection]}${entry.id}/`, visibility: entry.data.visibility, publicReview: entry.data.publicReview }])));
}

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  const projects = publicEntries(entries.map((entry) => {
    const { visibility, publicReview, title, order, id } = entry.data;
    return { visibility, publicReview, title, id, ...(order === undefined ? {} : { order }) };
  }));
  return projects.map((project) => {
    const entry = entries.find((candidate) => candidate.data.id === project.id);
    if (!entry) throw new Error(`Missing project entry for ${project.id}.`);
    return { params: { slug: entry.id }, props: { project: entry } };
  });
}

interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { Content } = await render(project);
const narrative = project.data.capabilityNarrative;
if (!narrative) throw new Error(`Public project ${project.data.id} requires a capability narrative.`);
const targets = await relationshipTargets();
const pathways = resolveRelationshipPathways(project.data, targets);
const principles = narrative.principleIds.flatMap((id) => {
  const target = targets.get(id);
  return target?.href ? [{ title: target.title, href: target.href }] : [];
});
const sourceLinks = project.data.sourceUrls.map((href) => ({ label: 'Project source', href }));
---

<CatalogArticleLayout
  title={project.data.title}
  description={project.data.summary}
  canonicalPath={`/work/${project.id}/`}
  updatedAt={project.data.updatedAt}
  status={project.data.status}
  narrative={narrative}
  position={`A ${project.data.status} capability within the wider systems catalog.`}
  pathways={pathways}
  sources={sourceLinks}
>
  <div slot="principles"><ul>{principles.map((principle) => <li><a href={principle.href}>{principle.title}</a></li>)}</ul></div>
  <div slot="evidence"><p>{project.data.evidenceSummary?.evidenceScope ?? 'Public description is limited to reviewed material and intentionally excludes unapproved operational detail.'}</p></div>
  <div class="project-meta"><ul aria-label="Capabilities">{project.data.capabilities.map((capability) => <li><CapabilityTag capability={capability} /></li>)}</ul></div>
  <Content />
</CatalogArticleLayout>

<style>
  .project-meta ul { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-4) 0; padding: 0; list-style: none; }
</style>
